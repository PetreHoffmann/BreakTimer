<UserControl x:Class="BreakTimer.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BreakTimer.App.Views.Controls"
             xmlns:cv="clr-namespace:BreakTimer.App.Converters">
    <UserControl.Resources>
        <cv:StatusLevelBrushConverter x:Key="LevelBrush"/>
        <cv:VisibilityConverter x:Key="Vis"/>
        <cv:InverseBoolConverter x:Key="Inv"/>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
            <TextBlock Text="Pausen starten, steuern und im Blick behalten." Style="{StaticResource Dim}" Margin="0,2,0,22"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Linke Spalte -->
                <StackPanel Grid.Column="0">
                    <!-- Status -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="14" Padding="14,5" Background="{StaticResource Surface3Brush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Fill="{Binding Timer.StatusLevel, Converter={StaticResource LevelBrush}}"/>
                                        <TextBlock Text="{Binding Timer.StatusText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Verbleibende Zeit" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Timer.RemainingText}" FontFamily="Bahnschrift, Segoe UI" FontWeight="Light" FontSize="104"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="White">
                                <TextBlock.Effect><DropShadowEffect Color="#18E6FF" BlurRadius="30" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect>
                            </TextBlock>
                            <ProgressBar Value="{Binding Timer.Progress, Mode=OneWay}" Margin="0,8,0,18"/>
                            <UniformGrid Rows="1" Columns="4">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Eingestellte Pause" Style="{StaticResource TileLabel}"/>
                                    <TextBlock Text="{Binding Timer.DurationText}" Style="{StaticResource TileValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Voraussichtliches Ende" Style="{StaticResource TileLabel}"/>
                                    <TextBlock Text="{Binding Timer.EndTimeText}" Style="{StaticResource TileValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Zielmonitor (Anzeige)" Style="{StaticResource TileLabel}"/>
                                    <TextBlock Text="{Binding Monitors.DisplayTargetText}" Style="{StaticResource TileValue}" ToolTip="{Binding Monitors.DisplayTargetText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Steuerungsmonitor" Style="{StaticResource TileLabel}"/>
                                    <TextBlock Text="{Binding Monitors.ControlMonitorText}" Style="{StaticResource TileValue}" ToolTip="{Binding Monitors.ControlMonitorText}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Pausendauer -->
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Pausendauer" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipButton}" Margin="0,0,8,8" MinWidth="76" Content="{Binding StringFormat={}{0} min}"
                                                Command="{Binding DataContext.Timer.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding Timer.CanEditDuration}">
                                <StackPanel>
                                    <TextBlock Text="Minuten" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Width="96" Text="{Binding Timer.MinutesInput, UpdateSourceTrigger=PropertyChanged}" FontSize="22" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text=":" FontSize="26" Margin="10,22,10,0" Style="{StaticResource Dim}"/>
                                <StackPanel>
                                    <TextBlock Text="Sekunden" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Width="96" Text="{Binding Timer.SecondsInput, UpdateSourceTrigger=PropertyChanged}" FontSize="22" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Margin="22,24,0,0" Style="{StaticResource Dim}" TextWrapping="Wrap" MaxWidth="320"
                                           Text="Freie Eingabe: 00:01 bis 24 Stunden. Während einer laufenden Pause ändern Sie die Zeit mit den Schaltflächen darunter."
                                           Visibility="{Binding Timer.IsActive, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Timer.ValidationMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Timer.HasValidationMessage, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Anpassen -->
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Zeit anpassen" Style="{StaticResource H2}"/>
                            <TextBlock Text="Verlängern oder verkürzen – sofort auch auf dem Break Display." Style="{StaticResource Dim}" Margin="0,2,0,12"/>
                            <WrapPanel>
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,8,8" Content="− 5 min" Command="{Binding Timer.AdjustCommand}" CommandParameter="-5"/>
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,8,8" Content="− 1 min" Command="{Binding Timer.AdjustCommand}" CommandParameter="-1"/>
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,8,8" Content="+ 1 min" Command="{Binding Timer.AdjustCommand}" CommandParameter="1"/>
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,8,8" Content="+ 5 min" Command="{Binding Timer.AdjustCommand}" CommandParameter="5"/>
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,8,8" Content="+ 10 min" Command="{Binding Timer.AdjustCommand}" CommandParameter="10"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBox Width="90" Text="{Binding Timer.CustomMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" ToolTip="Minuten (z. B. 2 oder 2,5)"/>
                                <TextBlock Text="min" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,16,0"/>
                                <Button Style="{StaticResource ChipButton}" Content="Hinzufügen" Command="{Binding Timer.AddCustomCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource ChipButton}" Content="Abziehen" Command="{Binding Timer.SubCustomCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Rechte Spalte -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Break Display" Style="{StaticResource H2}"/>
                            <TextBlock Text="Zielmonitor" Style="{StaticResource Caption}" Margin="0,14,0,4"/>
                            <ComboBox ItemsSource="{Binding Monitors.Items}" SelectedItem="{Binding Monitors.SelectedDisplay, Mode=TwoWay}" DisplayMemberPath="Title"/>
                            <TextBlock Text="Steuerungsmonitor" Style="{StaticResource Caption}" Margin="0,14,0,4"/>
                            <TextBlock Text="{Binding Monitors.ControlMonitorText}" TextWrapping="Wrap"/>
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                             Fill="{Binding Timer.DisplayStatusLevel, Converter={StaticResource LevelBrush}}"/>
                                    <TextBlock Text="{Binding Timer.DisplayStatusText}" TextWrapping="Wrap" MaxWidth="250"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Monitors.WarningText}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"
                                       Visibility="{Binding Monitors.HasWarning, Converter={StaticResource Vis}}"/>
                            <Button Margin="0,16,0,0" Command="{Binding Timer.TestDisplayCommand}" IsEnabled="{Binding Timer.IsActive, Converter={StaticResource Inv}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource IconCast}" Margin="0,0,10,0"/>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="Auf Display testen"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Timer.IsTestOpen}" Value="True">
                                                        <Setter Property="Text" Value="Testanzeige beenden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Aktuelles Design" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding ThemeName}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="15"/>
                            <TextBlock Text="Im Design Editor und bei den Themes anpassen." Style="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Tastenkürzel" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Dim}" FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                       Text="Leertaste  Start / Pause / Fortsetzen&#x0a;Esc  Stop&#x0a;+ / −  Eine Minute hinzufügen / abziehen&#x0a;Strg+R  Zurücksetzen&#x0a;Strg+S  Speichern"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
