<Window x:Class="BreakTimer.App.Views.MiniControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BreakTimer.App.Views.Controls"
        xmlns:cv="clr-namespace:BreakTimer.App.Converters"
        Title="Break Timer – Mini-Steuerung" Width="470" Height="132" ResizeMode="NoResize" WindowStyle="None"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" AllowsTransparency="False"
        Background="{StaticResource SidebarBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <cv:VisibilityConverter x:Key="Vis"/>
    </Window.Resources>
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" Padding="14,10" MouseLeftButtonDown="OnDrag" Background="{StaticResource WindowGradient}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Anzeige läuft auf diesem Monitor" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding RemainingText}" FontFamily="Bahnschrift, Segoe UI" FontWeight="Light" FontSize="30" Foreground="White"/>
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Button Style="{StaticResource ChipButton}" Command="{Binding PauseCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsPaused, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconPause}" Margin="0,0,6,0"/><TextBlock Text="Pause"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ChipButton}" Command="{Binding ResumeCommand}" Margin="0,0,8,0" Visibility="{Binding IsPaused, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconPlay}" Margin="0,0,6,0"/><TextBlock Text="Weiter"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ChipButton}" Content="−1" Command="{Binding AdjustCommand}" CommandParameter="-1" Margin="0,0,8,0" MinWidth="44"/>
                <Button Style="{StaticResource ChipButton}" Content="+1" Command="{Binding AdjustCommand}" CommandParameter="1" Margin="0,0,8,0" MinWidth="44"/>
                <Button Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" MinWidth="96" ToolTip="Pause beenden und Control Center anzeigen">
                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconStop}" Margin="0,0,6,0"/><TextBlock Text="STOP"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
