<Window x:Class="BreakTimer.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Break Timer" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Border Padding="24" Background="{StaticResource WindowGradient}">
        <StackPanel>
            <TextBlock x:Name="PromptText" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBox x:Name="Input" FontSize="15" MinHeight="40" KeyDown="OnKeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Abbrechen" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0" MinWidth="100"/>
                <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="100"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
