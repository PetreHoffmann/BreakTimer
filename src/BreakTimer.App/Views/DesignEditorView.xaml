<UserControl x:Class="BreakTimer.App.Views.DesignEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BreakTimer.App.Views.Controls"
             xmlns:d="clr-namespace:BreakTimer.App.Views.Display"
             xmlns:cv="clr-namespace:BreakTimer.App.Converters">
    <UserControl.Resources>
        <cv:VisibilityConverter x:Key="Vis"/>
        <cv:FileMissingConverter x:Key="Missing"/>
        <cv:InverseBoolConverter x:Key="Inv"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Einstellungen -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Design Editor" Style="{StaticResource H1}"/>
                <TextBlock Text="Änderungen erscheinen sofort in der Vorschau und auf dem Display." Style="{StaticResource Dim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>
                    <!-- FARBEN -->
                    <Expander Header="Farben" IsExpanded="True">
                        <StackPanel>
                            <c:ColorRow Label="Hintergrundfarbe" ColorHex="{Binding Theme.BackgroundColor, Mode=TwoWay}"/>
                            <CheckBox Content="Farbverlauf verwenden" IsChecked="{Binding Theme.GradientEnabled}" Style="{StaticResource Toggle}"/>
                            <c:ColorRow Label="Verlauf – Startfarbe" ColorHex="{Binding Theme.GradientStart, Mode=TwoWay}"/>
                            <c:ColorRow Label="Verlauf – Endfarbe" ColorHex="{Binding Theme.GradientEnd, Mode=TwoWay}"/>
                            <c:SliderRow Label="Verlaufswinkel" Minimum="0" Maximum="360" Suffix="°" Value="{Binding Theme.GradientAngle}"/>
                            <c:ColorRow Label="Countdown-Farbe" ColorHex="{Binding Theme.CountdownColor, Mode=TwoWay}"/>
                            <c:ColorRow Label="Überschriftenfarbe" ColorHex="{Binding Theme.HeadingColor, Mode=TwoWay}"/>
                            <c:ColorRow Label="Textfarbe" ColorHex="{Binding Theme.TextColor, Mode=TwoWay}"/>
                            <c:ColorRow Label="Akzentfarbe (Endzeit, Slogan, Logo, Partikel)" ColorHex="{Binding Theme.AccentColor, Mode=TwoWay}"/>
                            <c:ColorRow Label="Sekundärfarbe (Grafik, Logo)" ColorHex="{Binding Theme.SecondaryColor, Mode=TwoWay}"/>
                            <c:ColorRow Label="Neon-Glow-Farbe" ColorHex="{Binding Theme.GlowColor, Mode=TwoWay}"/>
                            <c:ColorRow Label="Footer-Farbe" ColorHex="{Binding Theme.FooterColor, Mode=TwoWay}"/>
                        </StackPanel>
                    </Expander>

                    <!-- TEXTE -->
                    <Expander Header="Texte">
                        <StackPanel>
                            <TextBlock Text="Firmenname" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Theme.CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Slogan" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Theme.Slogan, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Hauptüberschrift" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Theme.Heading, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Pausentext" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Theme.BreakText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Endzeit-Text  ({time} = berechnete Uhrzeit)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Theme.EndTimeText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Footer-Text" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Theme.FooterText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Website" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Theme.Website, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Text bei abgelaufener Pause" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Theme.FinishedText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Expander>

                    <!-- SCHRIFT -->
                    <Expander Header="Schrift">
                        <StackPanel>
                            <TextBlock Text="Überschrift-Schriftart" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEditable="True" ItemsSource="{Binding FontFamilies}" Text="{Binding Theme.HeadingFont, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Überschrift-Gewicht" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding FontWeights}" SelectedItem="{Binding Theme.HeadingWeight}"/>
                            <c:SliderRow Label="Überschrift-Größe" Minimum="30" Maximum="260" Value="{Binding Theme.HeadingSize}"/>
                            <TextBlock Text="Textschriftart" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEditable="True" ItemsSource="{Binding FontFamilies}" Text="{Binding Theme.BodyFont, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Text-Gewicht" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding FontWeights}" SelectedItem="{Binding Theme.BodyWeight}"/>
                            <c:SliderRow Label="Schriftgröße (Text)" Minimum="20" Maximum="100" Value="{Binding Theme.BodySize}"/>
                            <TextBlock Text="Countdown-Schriftart (gleichbreite Ziffern empfohlen)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEditable="True" ItemsSource="{Binding FontFamilies}" Text="{Binding Theme.CountdownFont, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Countdown-Gewicht" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding FontWeights}" SelectedItem="{Binding Theme.CountdownWeight}"/>
                            <c:SliderRow Label="Countdown-Größe" Minimum="120" Maximum="620" Value="{Binding Theme.CountdownSize}"/>
                            <TextBlock Text="Textausrichtung" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Theme.TextAlignment}"/>
                            <c:SliderRow Label="Zeilenabstand" Minimum="0.8" Maximum="2" Step="0.05" Format="0.00" Value="{Binding Theme.LineSpacing}"/>
                        </StackPanel>
                    </Expander>

                    <!-- LAYOUT -->
                    <Expander Header="Layout">
                        <StackPanel>
                            <CheckBox Content="Header anzeigen" IsChecked="{Binding Theme.ShowHeader}" Style="{StaticResource Toggle}"/>
                            <CheckBox Content="Footer anzeigen" IsChecked="{Binding Theme.ShowFooter}" Style="{StaticResource Toggle}"/>
                            <CheckBox Content="Grafik anzeigen" IsChecked="{Binding Theme.ShowIllustration}" Style="{StaticResource Toggle}"/>
                            <TextBlock Text="Header-Position" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Theme.HeaderPosition}"/>
                            <TextBlock Text="Footer-Position" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Theme.FooterPosition}"/>
                            <TextBlock Text="Grafik-Motiv" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Theme.IllustrationStyle}"/>
                            <TextBlock Text="Grafik-Position" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Theme.IllustrationPosition}"/>
                            <c:SliderRow Label="Grafik – Größe" Minimum="0.3" Maximum="3" Step="0.05" Format="0.00" Suffix=" ×" Value="{Binding Theme.IllustrationScale}"/>
                            <c:SliderRow Label="Grafik – Deckkraft" Minimum="0" Maximum="1" Step="0.05" Format="0.00" Value="{Binding Theme.IllustrationOpacity}"/>
                            <c:SliderRow Label="Grafik – Drehgeschwindigkeit (0 = Stillstand)" Minimum="0" Maximum="10" Step="0.1" Format="0.0" Suffix=" ×" Value="{Binding Theme.IllustrationSpeed}"/>
                            <c:SliderRow Label="Grafik – horizontal verschieben" Minimum="-900" Maximum="900" Value="{Binding Theme.IllustrationOffsetX}"/>
                            <c:SliderRow Label="Grafik – vertikal verschieben" Minimum="-600" Maximum="600" Value="{Binding Theme.IllustrationOffsetY}"/>
                            <c:SliderRow Label="Countdown – horizontal verschieben" Minimum="-900" Maximum="900" Value="{Binding Theme.CountdownOffsetX}"/>
                            <c:SliderRow Label="Countdown – vertikal verschieben" Minimum="-500" Maximum="500" Value="{Binding Theme.CountdownOffsetY}"/>
                            <c:SliderRow Label="Horizontaler Abstand" Minimum="0" Maximum="400" Value="{Binding Theme.HorizontalPadding}"/>
                            <c:SliderRow Label="Vertikaler Abstand" Minimum="0" Maximum="300" Value="{Binding Theme.VerticalPadding}"/>
                            <c:SliderRow Label="Größe Hauptbereich" Minimum="0.4" Maximum="1.6" Step="0.05" Format="0.00" Suffix=" ×" Value="{Binding Theme.MainScale}"/>
                            <c:SliderRow Label="Größe Header" Minimum="0.4" Maximum="2" Step="0.05" Format="0.00" Suffix=" ×" Value="{Binding Theme.HeaderScale}"/>
                            <c:SliderRow Label="Größe Footer" Minimum="0.4" Maximum="2" Step="0.05" Format="0.00" Suffix=" ×" Value="{Binding Theme.FooterScale}"/>
                            <Button Content="Layout zurücksetzen" Style="{StaticResource GhostButton}" Command="{Binding ResetLayoutCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>

                    <!-- LOTTIE -->
                    <Expander Header="Lottie-Animation">
                        <StackPanel>
                            <TextBlock Text="Eigene Lottie-Animationen (.json, z. B. aus After Effects/LottieFiles) als Ebene im Display." Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource ChipButton}" Command="{Binding ImportLottieCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconImage}" Margin="0,0,8,0"/><TextBlock Text="Lottie importieren"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ChipButton}" Content="Entfernen" Command="{Binding RemoveLottieCommand}" IsEnabled="{Binding HasLottie}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LottieName}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="Ebene" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LottieLayers}" SelectedItem="{Binding Theme.LottieLayer}"/>
                            <TextBlock Text="Anpassung" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LottieFits}" SelectedItem="{Binding Theme.LottieFit}"/>
                            <c:SliderRow Label="Größe" Minimum="0.2" Maximum="3" Step="0.05" Format="0.00" Suffix=" ×" Value="{Binding Theme.LottieScale}"/>
                            <c:SliderRow Label="Deckkraft" Minimum="0" Maximum="1" Step="0.05" Format="0.00" Value="{Binding Theme.LottieOpacity}"/>
                            <c:SliderRow Label="Geschwindigkeit" Minimum="0.1" Maximum="5" Step="0.1" Format="0.0" Suffix=" ×" Value="{Binding Theme.LottieSpeed}"/>
                            <c:SliderRow Label="Horizontal verschieben" Minimum="-960" Maximum="960" Value="{Binding Theme.LottieOffsetX}"/>
                            <c:SliderRow Label="Vertikal verschieben" Minimum="-540" Maximum="540" Value="{Binding Theme.LottieOffsetY}"/>
                            <CheckBox Content="Endlos wiederholen" IsChecked="{Binding Theme.LottieLoop}" Style="{StaticResource Toggle}"/>
                        </StackPanel>
                    </Expander>

                    <!-- HINTERGRUND -->
                    <Expander Header="Hintergrundbild">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource ChipButton}" Command="{Binding ImportBackgroundCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconImage}" Margin="0,0,8,0"/><TextBlock Text="Bild importieren"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ChipButton}" Content="Entfernen" Command="{Binding RemoveBackgroundCommand}" IsEnabled="{Binding HasBackgroundImage}"/>
                            </StackPanel>
                            <TextBlock Text="Die Bilddatei wurde nicht gefunden. Bitte neu importieren." Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding Theme.BackgroundImagePath, Converter={StaticResource Missing}}"/>
                            <TextBlock Text="Bildanpassung" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Stretches}" SelectedItem="{Binding Theme.BackgroundImageStretch}"/>
                            <c:SliderRow Label="Bildgröße" Minimum="50" Maximum="300" Suffix=" %" Value="{Binding Theme.BackgroundImageScale}"/>
                            <c:SliderRow Label="Position horizontal" Minimum="-50" Maximum="50" Suffix=" %" Value="{Binding Theme.BackgroundImageOffsetX}"/>
                            <c:SliderRow Label="Position vertikal" Minimum="-50" Maximum="50" Suffix=" %" Value="{Binding Theme.BackgroundImageOffsetY}"/>
                            <CheckBox Content="Overlay aktivieren" IsChecked="{Binding Theme.OverlayEnabled}" Style="{StaticResource Toggle}"/>
                            <c:ColorRow Label="Overlay-Farbe" ColorHex="{Binding Theme.OverlayColor, Mode=TwoWay}"/>
                            <c:SliderRow Label="Overlay-Transparenz (Deckkraft)" Minimum="0" Maximum="100" Suffix=" %" Value="{Binding Theme.OverlayOpacity}"/>
                        </StackPanel>
                    </Expander>

                    <!-- LOGO -->
                    <Expander Header="Logo">
                        <StackPanel>
                            <CheckBox Content="Logo anzeigen" IsChecked="{Binding Theme.LogoVisible}" Style="{StaticResource Toggle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource ChipButton}" Command="{Binding ImportLogoCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconImage}" Margin="0,0,8,0"/><TextBlock Text="Logo importieren"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ChipButton}" Content="Entfernen" Command="{Binding RemoveLogoCommand}" IsEnabled="{Binding HasLogo}"/>
                            </StackPanel>
                            <TextBlock Text="Ohne eigenes Logo erscheint das Break-Timer-Zeichen in den Akzentfarben." Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="Die Logodatei wurde nicht gefunden – es wird das Standardzeichen angezeigt." Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding Theme.LogoPath, Converter={StaticResource Missing}}"/>
                            <c:SliderRow Label="Logogröße" Minimum="24" Maximum="320" Value="{Binding Theme.LogoSize}"/>
                            <TextBlock Text="Logoposition (zum Firmennamen)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LogoPositions}" SelectedItem="{Binding Theme.LogoPosition}"/>
                        </StackPanel>
                    </Expander>

                    <!-- EFFEKTE -->
                    <Expander Header="Effekte">
                        <StackPanel>
                            <TextBlock Text="Alle Effekte sind optional. Mit dem Hauptschalter unter „Einstellungen“ lassen sich sämtliche Animationen abschalten." Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <CheckBox Content="Neon-Glow" IsChecked="{Binding Theme.GlowEnabled}" Style="{StaticResource Toggle}"/>
                            <c:SliderRow Label="Glow-Intensität" Minimum="0" Maximum="100" Value="{Binding Theme.GlowIntensity}"/>
                            <CheckBox Content="Hintergrundanimation (Verlauf &amp; Lichtflächen)" IsChecked="{Binding Theme.BackgroundAnimation}" Style="{StaticResource Toggle}"/>
                            <CheckBox Content="Partikelanimation" IsChecked="{Binding Theme.ParticlesEnabled}" Style="{StaticResource Toggle}"/>
                            <CheckBox Content="Lichtanimation (Lichtschweif)" IsChecked="{Binding Theme.LightAnimation}" Style="{StaticResource Toggle}"/>
                            <CheckBox Content="Countdown-Animation" IsChecked="{Binding Theme.CountdownAnimation}" Style="{StaticResource Toggle}"/>
                            <CheckBox Content="Übergangseffekte (Ein- und Ausblenden)" IsChecked="{Binding Theme.TransitionEffects}" Style="{StaticResource Toggle}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Vorschau -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Live-Vorschau" Style="{StaticResource H2}" Margin="0,6,0,10"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding Timer.TestDisplayCommand}" Margin="0,0,10,8"
                            IsEnabled="{Binding Timer.IsActive, Converter={StaticResource Inv}}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IconCast}" Margin="0,0,8,0"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="Auf Display testen"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Timer.IsTestOpen}" Value="True"><Setter Property="Text" Value="Test beenden"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Command="{Binding SaveCommand}" Margin="0,0,10,8">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconSave}" Margin="0,0,8,0"/><TextBlock Text="Speichern"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Command="{Binding SaveAsCommand}" Margin="0,0,10,8">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconCopy}" Margin="0,0,8,0"/><TextBlock Text="Als Theme speichern"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Content="Änderungen verwerfen" Command="{Binding RevertCommand}" Margin="0,0,10,8"/>
                </WrapPanel>
            </StackPanel>
            <CheckBox DockPanel.Dock="Bottom" Content="Zustand „Pause beendet“ in der Vorschau zeigen" IsChecked="{Binding PreviewFinished}" Margin="0,12,0,0"/>
            <Border Background="Black" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="6">
                <c:AspectBox Ratio="1.7777778">
                    <Border CornerRadius="8" ClipToBounds="True">
                        <d:BreakScreenView DataContext="{Binding Display}"/>
                    </Border>
                </c:AspectBox>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
