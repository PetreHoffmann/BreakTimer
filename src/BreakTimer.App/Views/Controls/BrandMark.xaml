<UserControl x:Class="BreakTimer.App.Views.Controls.BrandMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" IsHitTestVisible="False">
    <!-- Eigenes Break-Timer-Logo: Ring mit Lücke, Zeiger und Akzentbogen -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">
            <Ellipse Width="94" Height="94" Canvas.Left="3" Canvas.Top="3" StrokeThickness="1.2" Stroke="#33FFFFFF">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A1160" Offset="0"/>
                        <GradientStop Color="#080416" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path Data="M 50,20 A 30,30 0 1 1 21.81,60.26" Stroke="{Binding AccentBrush, ElementName=Root}" StrokeThickness="8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 20.11,52.61 A 30,30 0 0 1 32.79,25.43" Stroke="{Binding SecondaryBrush, ElementName=Root}" StrokeThickness="8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 50,50 L 50,31" Stroke="White" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Ellipse Width="10" Height="10" Canvas.Left="45" Canvas.Top="45" Fill="White"/>
        </Canvas>
    </Viewbox>
</UserControl>
