<UserControl x:Class="BreakTimer.App.Views.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="34">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ToggleButton x:Name="SwatchButton" Width="44" Height="34" Cursor="Hand" Focusable="False"
                      Background="{Binding Swatch, ElementName=Root}"
                      IsChecked="{Binding IsOpen, ElementName=PickerPopup, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="{TemplateBinding Background}">
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <TextBox x:Name="HexBox" Grid.Column="1" Margin="8,0,0,0" MaxLength="9" Height="34" Padding="10,0" Foreground="{StaticResource TextBrush}"
                 LostFocus="OnHexCommit" KeyDown="OnHexKeyDown" CharacterCasing="Upper"/>

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12"
                    Margin="0,6,12,12" Padding="14" Width="270">
                <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55"/></Border.Effect>
                <StackPanel>
                    <WrapPanel x:Name="Presets" Margin="0,0,0,10"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <TextBlock Text="R" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderR" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderR, StringFormat=0}" Style="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <TextBlock Text="G" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderG" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderG, StringFormat=0}" Style="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <TextBlock Text="B" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderB" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SliderB, StringFormat=0}" Style="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
