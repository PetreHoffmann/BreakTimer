<UserControl x:Class="BreakTimer.App.Views.ThemesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BreakTimer.App.Views.Controls"
             xmlns:cv="clr-namespace:BreakTimer.App.Converters">
    <UserControl.Resources>
        <cv:HexColorConverter x:Key="Hex"/>
        <cv:VisibilityConverter x:Key="Vis"/>
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="38"/><Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ChipButton}" Command="{Binding ImportCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconImport}" Margin="0,0,8,0"/><TextBlock Text="Theme importieren"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCurrentAsCommand}">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconSave}" Margin="0,0,8,0"/><TextBlock Text="Aktuelles Design speichern"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Themes" Style="{StaticResource H1}"/>
                    <TextBlock Text="Standard-Themes sind schreibgeschützt – duplizieren Sie sie, um eigene Varianten zu erstellen." Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,16,16" Padding="0" CornerRadius="14" BorderThickness="1.5" Background="{StaticResource SurfaceBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- Farbvorschau -->
                                <Border Height="118" CornerRadius="13,13,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{Binding GradientStart, Converter={StaticResource Hex}}" Offset="0"/>
                                            <GradientStop Color="{Binding GradientEnd, Converter={StaticResource Hex}}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Sample}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                                            <TextBlock Text="12:20" FontSize="40" FontWeight="Light" FontFamily="Bahnschrift, Segoe UI" HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Effect><DropShadowEffect Color="{Binding Accent, Converter={StaticResource Hex}}" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12">
                                            <Ellipse Width="14" Height="14" Fill="{Binding Accent, Converter={StaticResource Hex}}" Margin="0,0,6,0"/>
                                            <Ellipse Width="14" Height="14" Fill="{Binding Secondary, Converter={StaticResource Hex}}"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="10" Padding="10,3" Background="{StaticResource AccentBrush}"
                                                Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                            <TextBlock Text="AKTIV" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnAccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="16,14,16,16">
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,12"/>
                                    <Button Content="Aktivieren" Style="{StaticResource ChipButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconBtn}" ToolTip="Duplizieren" Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><c:Icon Data="{StaticResource IconCopy}"/></Button>
                                        <Button Style="{StaticResource IconBtn}" ToolTip="Umbenennen" Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><c:Icon Data="{StaticResource IconEdit}"/></Button>
                                        <Button Style="{StaticResource IconBtn}" ToolTip="Exportieren" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><c:Icon Data="{StaticResource IconExport}"/></Button>
                                        <Button Style="{StaticResource IconBtn}" ToolTip="Löschen" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><c:Icon Data="{StaticResource IconDelete}"/></Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
