<UserControl x:Class="BreakTimer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BreakTimer.App.Views.Controls"
             xmlns:cv="clr-namespace:BreakTimer.App.Converters">
    <UserControl.Resources>
        <cv:VisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Einstellungen" Style="{StaticResource H1}"/>
            <TextBlock Text="Alle Änderungen werden automatisch gespeichert." Style="{StaticResource Dim}" Margin="0,2,0,22"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Darstellung &amp; Verhalten" Style="{StaticResource H2}"/>
                    <CheckBox Content="Animationen aktivieren (Hauptschalter für alle Bewegungen und Übergänge)" IsChecked="{Binding AnimationsEnabled}" Margin="0,14,0,0"/>
                    <TextBlock Text="Bei deaktivierten Animationen bleibt das Design vollständig erhalten – es bewegt sich nur nichts. Das spart Leistung auf schwächeren Rechnern." Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="52,4,0,0"/>
                    <CheckBox Content="Bildschirm und PC während der Pause wach halten" IsChecked="{Binding KeepAwakeDuringBreak}" Margin="0,16,0,0"/>
                    <TextBlock Text="Solange das Break Display offen ist, schaltet sich der Monitor nicht aus, und Bildschirmschoner und Energiesparmodus bleiben aus – dadurch sperrt sich Windows nicht wegen Inaktivität. Eine per Richtlinie erzwungene Sperre nach festgelegter Leerlaufzeit lässt sich so nicht in jedem Fall verhindern." Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="52,4,0,0"/>
                    <CheckBox Content="Display nach Ablauf der Pause automatisch schließen" IsChecked="{Binding CloseDisplayAfterFinish}" Margin="0,16,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="52,8,0,0" IsEnabled="{Binding CloseDisplayAfterFinish}">
                        <TextBlock Text="nach" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                        <TextBox Width="70" Margin="10,0" Text="{Binding CloseDelayText, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="Sekunden" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Audio" Style="{StaticResource H2}"/>
                    <CheckBox Content="Signalton bei Ablauf der Pause abspielen" IsChecked="{Binding SoundEnabled}" Margin="0,14,0,0"/>
                    <TextBlock Text="Ohne diese Aktivierung wird niemals ein Ton abgespielt." Style="{StaticResource Dim}" FontSize="12" Margin="52,4,0,0"/>
                    <TextBlock Text="Sound" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                    <ComboBox ItemsSource="{Binding SoundPresets}" SelectedItem="{Binding SoundPreset}" Width="260" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsCustomSound, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource ChipButton}" Content="Datei wählen …" Command="{Binding ChooseSoundCommand}"/>
                        <TextBlock Text="{Binding CustomSoundDisplay}" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Dim}"/>
                    </StackPanel>
                    <Grid Margin="0,16,0,0" Width="420" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                        <c:Icon Data="{StaticResource IconVolume}" Margin="0,0,12,0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SoundVolumePercent}"/>
                        <TextBlock Grid.Column="2" Text="{Binding SoundVolumePercent, StringFormat={}{0:0} %}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource ChipButton}" Command="{Binding TestSoundCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconPlay}" Margin="0,0,8,0"/><TextBlock Text="Sound testen"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="Stopp" Command="{Binding StopSoundCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Daten &amp; Sicherung" Style="{StaticResource H2}"/>
                    <TextBlock Text="Datenordner" Style="{StaticResource Caption}" Margin="0,14,0,4"/>
                    <TextBlock Text="{Binding DataFolder}" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource ChipButton}" Command="{Binding SaveNowCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconSave}" Margin="0,0,8,0"/><TextBlock Text="Jetzt speichern (Strg+S)"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Command="{Binding ExportCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconExport}" Margin="0,0,8,0"/><TextBlock Text="Einstellungen exportieren"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Command="{Binding ImportCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconImport}" Margin="0,0,8,0"/><TextBlock Text="Einstellungen importieren"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChipButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconFolder}" Margin="0,0,8,0"/><TextBlock Text="Ordner öffnen"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <Button Style="{StaticResource GhostButton}" Content="Standardwerte wiederherstellen" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
