<UserControl x:Class="BreakTimer.App.Views.MonitorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BreakTimer.App.Views.Controls"
             xmlns:cv="clr-namespace:BreakTimer.App.Converters">
    <UserControl.Resources>
        <cv:VisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ChipButton}" Command="{Binding IdentifyCommand}" Margin="0,0,8,0" Content="Monitore identifizieren"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal"><c:Icon Data="{StaticResource IconReset}" Margin="0,0,8,0"/><TextBlock Text="Neu erkennen"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Monitore" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border Background="#33FFB84D" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,18,0,0"
                    Visibility="{Binding HasWarning, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource IconAlert}" Foreground="{StaticResource WarnBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" MaxWidth="880"/>
                </StackPanel>
            </Border>

            <!-- Anordnung -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Anordnung" Style="{StaticResource H2}"/>
                    <TextBlock Text="Klicken Sie einen Monitor an, um ihn als Anzeigemonitor zu wählen. Cyan = Break Display, Magenta = Control Center." Style="{StaticResource Dim}" Margin="0,2,0,12" FontSize="12.5"/>
                    <Border Background="{StaticResource BgBrush}" CornerRadius="12" Width="640" Height="250" HorizontalAlignment="Left" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding MapLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding MapTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="{Binding MapWidth}" Height="{Binding MapHeight}" Padding="0" Cursor="Hand"
                                            Command="{Binding DataContext.SetDisplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="8" BorderThickness="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}">
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Number}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Info.Resolution}" Style="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsControl}" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent2Brush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDisplay}" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="#3318E6FF"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Liste -->
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,18,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Content="Als Anzeige verwenden" Style="{StaticResource ChipButton}" Margin="0,0,0,8"
                                            Command="{Binding DataContext.SetDisplayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="Control Center hierher" Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.SetControlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="14" Background="{StaticResource Surface3Brush}" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding Number}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Kind}" FontSize="16" FontWeight="SemiBold"/>
                                        <Border CornerRadius="9" Padding="9,2" Margin="12,0,0,0" Background="{StaticResource AccentBrush}" Visibility="{Binding IsDisplay, Converter={StaticResource Vis}}">
                                            <TextBlock Text="BREAK DISPLAY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource OnAccentBrush}"/>
                                        </Border>
                                        <Border CornerRadius="9" Padding="9,2" Margin="8,0,0,0" Background="{StaticResource Accent2Brush}" Visibility="{Binding IsControl, Converter={StaticResource Vis}}">
                                            <TextBlock Text="CONTROL CENTER" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Details}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding WorkArea}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
