<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Break Timer Control Center: Farb-Tokens -->
    <Color x:Key="BgColor">#0B0716</Color>
    <Color x:Key="SidebarColor">#0F0A1E</Color>
    <Color x:Key="SurfaceColor">#150E2B</Color>
    <Color x:Key="Surface2Color">#1D1438</Color>
    <Color x:Key="Surface3Color">#281C4B</Color>
    <Color x:Key="LineColor">#2F2358</Color>
    <Color x:Key="TextColor">#F3F5FF</Color>
    <Color x:Key="TextDimColor">#9EA7CC</Color>
    <Color x:Key="AccentColor">#18E6FF</Color>
    <Color x:Key="Accent2Color">#FF2FB9</Color>
    <Color x:Key="DangerColor">#FF3B63</Color>
    <Color x:Key="SuccessColor">#3DDC97</Color>
    <Color x:Key="WarnColor">#FFB84D</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#04121A"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#18E6FF" Offset="0"/>
        <GradientStop Color="#2AA8FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4D73" Offset="0"/>
        <GradientStop Color="#E0204F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#18E6FF" Offset="0"/>
        <GradientStop Color="#FF2FB9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#150B30" Offset="0"/>
        <GradientStop Color="#080512" Offset="1"/>
    </LinearGradientBrush>

    <CornerRadius x:Key="CardRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlRadius">9</CornerRadius>
</ResourceDictionary>
